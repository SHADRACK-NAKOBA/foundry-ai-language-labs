# Copy to .env. Paste your model's Endpoint / Target URI from the Foundry portal (Build > Models > gpt-4o-mini-transcribe).
# The full Target URI is fine: the app keeps only https://<resource>.openai.azure.com (or .cognitiveservices.azure.com).
MODEL_ENDPOINT="https://<your-foundry-resource>.openai.azure.com/"
# Your DEPLOYMENT name (usually the same as the model name).
MODEL_NAME="gpt-4o-mini-transcribe"
